        <mxCell id="R8tlLwdC_zlUjm-hcj8g-3" value="&lt;div style=&quot;color: rgb(212, 212, 212); background-color: rgb(30, 30, 30); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space-collapse: preserve;&quot;&gt;&lt;div&gt;На каждую СК&lt;span style=&quot;color: rgb(220, 220, 220);&quot;&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &lt;span style=&quot;color: rgb(61, 201, 176);&quot;&gt;RateLimit&lt;/span&gt;&lt;span style=&quot;color: rgb(220, 220, 220);&quot;&gt;/&lt;/span&gt;&lt;span style=&quot;color: rgb(61, 201, 176);&quot;&gt;Throttling&lt;/span&gt;&lt;span style=&quot;color: rgb(220, 220, 220);&quot;&gt;:&lt;/span&gt; лимиты &lt;span style=&quot;color: rgb(61, 201, 176);&quot;&gt;RPS&lt;/span&gt; и concurrency&lt;/div&gt;&lt;div&gt;&amp;nbsp; &lt;span style=&quot;color: rgb(61, 201, 176);&quot;&gt;Circuit&lt;/span&gt; &lt;span style=&quot;color: rgb(61, 201, 176);&quot;&gt;Breaker&lt;/span&gt;&lt;span style=&quot;color: rgb(220, 220, 220);&quot;&gt;:&lt;/span&gt; open &lt;span style=&quot;color: rgb(181, 206, 168);&quot;&gt;30&lt;/span&gt;–&lt;span style=&quot;color: rgb(181, 206, 168);&quot;&gt;60&lt;/span&gt; c при ошибках&lt;span style=&quot;color: rgb(220, 220, 220);&quot;&gt;/&lt;/span&gt;таймаутах&lt;/div&gt;&lt;div&gt;&amp;nbsp; &lt;span style=&quot;color: rgb(61, 201, 176);&quot;&gt;Timeout&lt;/span&gt;&lt;span style=&quot;color: rgb(220, 220, 220);&quot;&gt;:&lt;/span&gt; бюджет на компанию ≤ &lt;span style=&quot;color: rgb(181, 206, 168);&quot;&gt;60&lt;/span&gt; c&lt;/div&gt;&lt;div&gt;&amp;nbsp; &lt;span style=&quot;color: rgb(61, 201, 176);&quot;&gt;Retry&lt;/span&gt;&lt;span style=&quot;color: rgb(220, 220, 220);&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: rgb(181, 206, 168);&quot;&gt;5&lt;/span&gt;xx&lt;span style=&quot;color: rgb(220, 220, 220);&quot;&gt;/&lt;/span&gt;&lt;span style=&quot;color: rgb(181, 206, 168);&quot;&gt;429&lt;/span&gt;&lt;span style=&quot;colo